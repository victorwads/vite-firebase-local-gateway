{
  "name": "vite-firebase-local-gateway",
  "version": "0.1.0",
  "description": "Local HTTPS gateway and CLI for Vite apps, Firebase Emulator and host-based dev routing.",
  "private": false,
  "type": "module",
  "license": "MIT",
  "author": "Wads",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/victorwads/vite-firebase-local-gateway.git"
  },
  "bugs": {
    "url": "https://github.com/victorwads/vite-firebase-local-gateway/issues"
  },
  "homepage": "https://github.com/victorwads/vite-firebase-local-gateway#readme",
  "keywords": [
    "vite",
    "firebase",
    "firebase-emulator",
    "emulator",
    "https",
    "https-localhost",
    "local-development",
    "reverse-proxy",
    "proxy",
    "cli",
    "devtools"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "vite-firebase-local-gateway": "./dist/cli.js"
  },
  "files": [
    "dist",
    "scripts",
    "examples",
    "docs",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    ".basicAuth.env.example",
    "gateway.config.example.js",
    "gateway.config.example.ts"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prebuild": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc",
    "postbuild": "node -e \"require('fs').chmodSync('dist/cli.js', 0o755)\"",
    "proxy": "tsx cli.ts",
    "start": "tsx cli.ts",
    "proxy:debug": "tsx --inspect=0.0.0.0:9230 cli.ts",
    "typecheck": "tsc --noEmit",
    "pack:dry-run": "npm --cache /private/tmp/npm-cache pack --dry-run",
    "prepack": "npm run build",
    "trust:macos": "bash scripts/trust-cert-macos.sh",
    "trust:linux": "bash scripts/trust-cert-linux.sh"
  },
  "dependencies": {
    "http-proxy": "^1.18.1",
    "mkcert": "^3.2.0"
  },
  "devDependencies": {
    "@types/http-proxy": "^1.17.16",
    "@types/node": "^24.7.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
